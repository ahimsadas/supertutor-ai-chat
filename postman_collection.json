{
  "info": {
    "name": "SuperTutor Backend (Local)",
    "description": "Postman collection for SuperTutor backend. Paste this JSON into Postman (Import > Raw Text). Uses {{baseUrl}} for server URL.\n\nCLI parity: you can upload files via the admin CLI: python -m app.cli.ingest upload --curriculum-id <UUID> <file1> <file2> ...\nFiles CLI: list/delete mirror these endpoints, e.g., python -m app.cli.files list --curriculum-id <UUID> and python -m app.cli.files delete --id <UUID>.\n\nStorage: bucket comes from env SUPABASE_FILES_BUCKET (default 'files'). On first use the backend ensures the bucket exists (attempts auto-create with service role key); otherwise it will instruct you to create it.\nEmbeddings: ingestion runner uses OpenAI text-embedding-3-small and requires OPENAI_API_KEY.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "provider", "value": "google" },
    { "key": "model", "value": "gemini-2.0-flash" },
    { "key": "label", "value": "Google (gemini-2.0-flash)" },
    { "key": "curriculum_id", "value": "" },
    { "key": "file_id", "value": "" }
  ],
  "item": [
    {
      "name": "Providers",
      "item": [
        {
          "name": "GET /providers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/providers"
          }
        }
      ]
    },
    {
      "name": "Languages",
      "item": [
        {
          "name": "GET /languages",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/languages"
          }
        }
      ]
    },
    {
      "name": "Curricula",
      "item": [
        {
          "name": "GET /curricula",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/curricula"
          }
        },
        {
          "name": "POST /curricula",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample Curriculum\"\n}"
            },
            "url": "{{baseUrl}}/curricula"
          }
        },
        {
          "name": "DELETE /curricula/{id}",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/curricula/{{curriculum_id}}"
          },
          "response": []
        },
        {
          "name": "DELETE /curricula/{id}?force=true",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/curricula/{{curriculum_id}}?force=true"
          }
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "POST /files:ingest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "curriculum_id", "value": "{{curriculum_id}}", "type": "text" },
                { "key": "files", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/files:ingest",
            "description": "On non-deduped success, the server writes uploaded bytes to Supabase Storage and persists storage metadata on the file record."
          }
        },
        {
          "name": "GET /files",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/files?curriculum_id={{curriculum_id}}"
          }
        },
        {
          "name": "DELETE /files/{id}",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/files/{{file_id}}"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /healthz",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/healthz"
          }
        }
      ]
    },
    {
      "name": "Debug",
      "item": [
        {
          "name": "GET /debug/env",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/debug/env"
          }
        },
        {
          "name": "GET /debug/checkpointer",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/debug/checkpointer"
          }
        },
        {
          "name": "GET /debug/provider (provider+model)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/debug/provider?provider={{provider}}&model={{model}}",
            "description": "Validate provider factory with separate provider and model query params."
          }
        },
        {
          "name": "GET /debug/provider (label)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/debug/provider?label={{label}}",
            "description": "Validate provider factory using a combined label like 'OpenAI (gpt-4o-mini)'."
          }
        }
      ]
    }
  ]
}
