{
  "info": {
    "name": "SuperTutor Backend (Local)",
    "description": "Postman collection for SuperTutor backend. Paste this JSON into Postman (Import > Raw Text). Uses {{scheme}}://{{host}}:{{port}} for server URL.\n\nCLI parity: you can upload files via the admin CLI: python -m app.cli.ingest upload --curriculum-id <UUID> <file1> <file2> ...\nFiles CLI: list/delete mirror these endpoints, e.g., python -m app.cli.files list --curriculum-id <UUID> and python -m app.cli.files delete --id <UUID>",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "scheme", "value": "http" },
    { "key": "host", "value": "localhost" },
    { "key": "port", "value": "8000" },
    { "key": "provider", "value": "google" },
    { "key": "model", "value": "gemini-2.0-flash" },
    { "key": "label", "value": "Google(gemini-2.0-flash)" },
    { "key": "curriculum_id", "value": "" }
  ],
  "item": [
    {
      "name": "Providers",
      "item": [
        {
          "name": "GET /providers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/providers",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["providers"]
            }
          }
        },
        {
          "name": "GET /files",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/files?curriculum_id={{curriculum_id}}",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["files"],
              "query": [
                { "key": "curriculum_id", "value": "{{curriculum_id}}" }
              ]
            }
          }
        },
        {
          "name": "DELETE /files/{id}",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/files/{{file_id}}",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["files", "{{file_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Languages",
      "item": [
        {
          "name": "GET /languages",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/languages",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["languages"]
            }
          }
        }
      ]
    },
    {
      "name": "Curricula",
      "item": [
        {
          "name": "GET /curricula",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/curricula",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["curricula"]
            }
          }
        },
        {
          "name": "POST /curricula",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample Curriculum\"\n}"
            },
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/curricula",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["curricula"]
            }
          }
        },
        {
          "name": "DELETE /curricula/{id}",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/curricula/{{curriculum_id}}",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["curricula", "{{curriculum_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "DELETE /curricula/{id}?force=true",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/curricula/{{curriculum_id}}?force=true",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["curricula", "{{curriculum_id}}"],
              "query": [
                { "key": "force", "value": "true" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "POST /files:ingest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "curriculum_id", "value": "{{curriculum_id}}", "type": "text" },
                { "key": "files", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/files:ingest",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["files:ingest"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /healthz",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/healthz",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["healthz"]
            }
          }
        }
      ]
    },
    {
      "name": "Debug",
      "item": [
        {
          "name": "GET /debug/env",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/debug/env",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["debug", "env"]
            }
          }
        },
        {
          "name": "GET /debug/checkpointer",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/debug/checkpointer",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["debug", "checkpointer"]
            }
          }
        },
        {
          "name": "GET /debug/provider (provider+model)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/debug/provider?provider={{provider}}&model={{model}}",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["debug", "provider"],
              "query": [
                { "key": "provider", "value": "{{provider}}" },
                { "key": "model", "value": "{{model}}" }
              ]
            },
            "description": "Validate provider factory with separate provider and model query params."
          }
        },
        {
          "name": "GET /debug/provider (label)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{scheme}}://{{host}}:{{port}}/debug/provider?label={{label}}",
              "protocol": "{{scheme}}",
              "host": ["{{host}}"],
              "port": "{{port}}",
              "path": ["debug", "provider"],
              "query": [
                { "key": "label", "value": "{{label}}" }
              ]
            },
            "description": "Validate provider factory using a combined label like 'OpenAI (gpt-4o-mini)'."
          }
        }
      ]
    }
  ]
}
